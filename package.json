{
  "name": "textlint-plugin-asciidoc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm/pkg"
  ],
  "scripts": {
    "build": "pnpm build:wasm && pnpm build:ts",
    "build:wasm": "wasm-pack build --target nodejs --mode no-install --out-dir wasm/pkg --out-name acdc_parser --locked",
    "build:ts": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build:wasm && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@textlint/ast-tester": "15.8.0",
    "@textlint/kernel": "15.8.0",
    "@types/node": "24.19.2",
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@textlint/ast-node-types": "15.8.0",
    "@textlint/types": "15.8.0"
  }
}
